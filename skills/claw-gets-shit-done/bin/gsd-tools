#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
NODE_SCRIPT="${SKILL_DIR}/upstream/get-shit-done/bin/gsd-tools.cjs"

if [[ ! -f "${NODE_SCRIPT}" ]]; then
  echo "gsd-tools not found: ${NODE_SCRIPT}" >&2
  exit 1
fi

node "${NODE_SCRIPT}" "$@"
